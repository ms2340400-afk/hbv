--[[
    MOG OR DIE — TELEPORT AUTO-FARM
    Instantly teleports to each collectible (Milk, Hammer, Picture Frame, Water).
    No walking, no lag — just instant farming.
]]

local Players = game:GetService("Players")
local Workspace = workspace
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local LocalPlayer = Players.LocalPlayer

-- ======================== CONFIG ========================
local targetNames = {
    "Milk",
    "Hammer",
    "Picture Frame",
    "Water"
}

local COLLECT_DELAY = 0.15  -- Time between teleports (seconds)
local MAX_DISTANCE = 500    -- Max distance to teleport

-- ======================== FIND COLLECTIBLES ========================
local function getCollectibles()
    local collectibles = {}
    
    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") then
            for _, name in pairs(targetNames) do
                if obj.Name:lower():match(name:lower()) then
                    table.insert(collectibles, {
                        Object = obj,
                        Position = obj.Position,
                        Name = obj.Name
                    })
                    break
                end
            end
        end
    end
    
    return collectibles
end

-- ======================== TELEPORT COLLECT ========================
local function teleportCollect()
    local char = LocalPlayer.Character
    if not char then return end
    
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    
    local collectibles = getCollectibles()
    local origin = root.Position
    
    -- Sort by distance (closest first)
    table.sort(collectibles, function(a, b)
        local distA = (origin - a.Position).Magnitude
        local distB = (origin - b.Position).Magnitude
        return distA < distB
    end)
    
    -- Teleport to each collectible
    for _, item in pairs(collectibles) do
        local dist = (origin - item.Position).Magnitude
        if dist < MAX_DISTANCE then
            -- Teleport to the item
            local teleportPos = item.Position + Vector3.new(0, 3, 0)  -- Slightly above
            root.CFrame = CFrame.new(teleportPos)
            
            -- Wait a tiny moment to register the collection
            wait(COLLECT_DELAY)
        end
    end
end

-- ======================== LOOP FOREVER ========================
local function startAutoFarm()
    while task.wait(0.5) do  -- Run every 0.5 seconds
        pcall(teleportCollect)
    end
end

-- ======================== HOTKEY: T TO COLLECT ONCE ========================
UserInputService.InputBegan:Connect(function(input)
    if input.KeyCode == Enum.KeyCode.T then
        pcall(teleportCollect)
        print("✅ Teleport collected!")
    end
end)

-- ======================== START FARMING ========================
task.spawn(startAutoFarm)

print("⚡ MOG OR DIE TELEPORT AUTO-FARM LOADED!")
print("🎯 Instantly teleports to: Milk, Hammer, Picture Frame, Water")
print("⌨️ Press T to manually teleport-collect once")
print("🔄 Auto-farming every 0.5 seconds...")
